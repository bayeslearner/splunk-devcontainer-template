# Copy to .env (task env:setup does this). .env is gitignored.

# ── Splunk ──────────────────────────────────────────────────────────
SPLUNK_PASSWORD=admin123
SPLUNK_VERSION=10.2.1
SPLUNK_GENERAL_TERMS=--accept-sgt-current-at-splunk-com
APP_NAME=
SPLUNKBASE_USERNAME=
SPLUNKBASE_PASSWORD=
SPLUNK_APPS_URL=

# ── Isolation ───────────────────────────────────────────────────────
# One set per checkout. The project name prefixes the network and volumes;
# a second checkout with the same name shares this one's Splunk state.
COMPOSE_PROJECT_NAME=devcontainer
DEV_CONTAINER_NAME=splunk-dev
STAGING_CONTAINER_NAME=splunk-staging
SPLUNK_IMAGE=devcontainer-splunk:latest

# ── Host ports ──────────────────────────────────────────────────────
# Pick a free band per checkout; `task dev:up` names any container already
# holding one of these before compose fails on "port already allocated".
SPLUNK_WEB_PORT=8000
SPLUNK_API_PORT=8089
SPLUNK_HEC_PORT=8088
SPLUNK_DEBUG_PORT=5678
STAGING_WEB_PORT=18000
STAGING_API_PORT=18089
STAGING_HEC_PORT=18088
